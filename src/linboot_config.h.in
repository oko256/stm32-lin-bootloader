#define LINBOOT_PROVIDER_OFFER_IDS    {@LINBOOT_PROVIDER_OFFER_IDS_C@}
/// minlin frame table entries of the OFFER frames (LINBOOT_FRAME() is defined by the user).
#define LINBOOT_PROVIDER_OFFER_FRAMES @LINBOOT_PROVIDER_OFFER_FRAMES_C@

// Timing and retries
#define LINBOOT_BOOT_TIMEOUT_MS       @LINBOOT_BOOT_TIMEOUT_MS@u
