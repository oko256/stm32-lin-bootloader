// Flash layout
#define LINBOOT_FLASH_BASE            @LINBOOT_FLASH_BASE@u
#define LINBOOT_FLASH_SIZE            @LINBOOT_FLASH_SIZE@u
#define LINBOOT_BOOTLOADER_SIZE       @LINBOOT_BOOTLOADER_SIZE@u
#define LINBOOT_FLASH_PAGE_SIZE       @LINBOOT_FLASH_PAGE_SIZE@u
#define LINBOOT_FLASH_WRITE_ALIGN     @LINBOOT_PORT_FLASH_WRITE_ALIGN@u
#define LINBOOT_APP_ADDR              @LINBOOT_APP_ADDR@u
#define LINBOOT_APP_MAX_SIZE          @LINBOOT_APP_MAX_SIZE@u
#define LINBOOT_META_ADDR             @LINBOOT_META_ADDR_RESOLVED@u
#define LINBOOT_BLOCK_SIZE            @LINBOOT_BLOCK_SIZE_RESOLVED@u
